//@version=5
strategy('BB Bounce', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
bbLen = input.int(20, 'BB Length')
bbMult = input.float(2.0, 'BB StdDev')

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
[middle, upper, lower] = ta.bb(close, bbLen, bbMult)

// ══════════════════════════════════════════
// CONDITIONS
// Bounce strategy: enter when price touches band and reverses
// ══════════════════════════════════════════
longCondition = low <= lower and close > open  // Touched lower, closed green
shortCondition = high >= upper and close < open  // Touched upper, closed red

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// Exit at middle band
if ta.crossover(close, middle) and strategy.position_size > 0
    strategy.close('Long')
if ta.crossunder(close, middle) and strategy.position_size < 0
    strategy.close('Short')

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(upper, 'Upper', color=color.red)
plot(middle, 'Middle', color=color.gray)
plot(lower, 'Lower', color=color.green)
fill(plot(upper), plot(lower), color=color.new(color.purple, 95))

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'BB Long', '{{ticker}} bounced off lower BB')
alertcondition(shortCondition, 'BB Short', '{{ticker}} rejected at upper BB')
