//@version=5
strategy('BB Breakout', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
[middle, upper, lower] = ta.bb(close, 20, 2.0)
volumeMA = ta.sma(volume, 20)

// ══════════════════════════════════════════
// CONDITIONS
// Breakout with volume confirmation
// ══════════════════════════════════════════
longCondition = close > upper and volume > volumeMA * 1.5
shortCondition = close < lower and volume > volumeMA * 1.5

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(upper, 'Upper', color=color.red)
plot(middle, 'Middle', color=color.gray)
plot(lower, 'Lower', color=color.green)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'BB Break Up', '{{ticker}} broke above upper BB with volume')
alertcondition(shortCondition, 'BB Break Down', '{{ticker}} broke below lower BB with volume')
