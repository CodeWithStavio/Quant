//@version=5
strategy('Z-Score Mean Reversion', overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
lookback = input.int(20, 'Lookback')
entryZ = input.float(2.0, 'Entry Z-Score')
exitZ = input.float(0.0, 'Exit Z-Score')

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
mean = ta.sma(close, lookback)
stdev = ta.stdev(close, lookback)
zScore = (close - mean) / stdev

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = ta.crossover(zScore, -entryZ)
shortCondition = ta.crossunder(zScore, entryZ)
exitLongCond = ta.crossover(zScore, exitZ)
exitShortCond = ta.crossunder(zScore, exitZ)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)
if exitLongCond
    strategy.close('Long')
if exitShortCond
    strategy.close('Short')

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(zScore, 'Z-Score', color=color.purple, linewidth=2)
hline(entryZ, '+2', color=color.red)
hline(-entryZ, '-2', color=color.green)
hline(0, '0', color=color.gray)
bgcolor(zScore < -entryZ ? color.new(color.green, 90) : zScore > entryZ ? color.new(color.red, 90) : na)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'ZScore Long', '{{ticker}} Z-Score below -2')
alertcondition(shortCondition, 'ZScore Short', '{{ticker}} Z-Score above +2')
