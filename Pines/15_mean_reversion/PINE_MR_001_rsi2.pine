//@version=5
strategy('RSI2 Mean Reversion', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
rsi2 = ta.rsi(close, 2)
ma200 = ta.sma(close, 200)

// ══════════════════════════════════════════
// CONDITIONS
// Long: RSI2 < 10 and above 200 MA (uptrend pullback)
// Short: RSI2 > 90 and below 200 MA (downtrend rally)
// ══════════════════════════════════════════
longCondition = rsi2 < 10 and close > ma200
exitLong = rsi2 > 70

shortCondition = rsi2 > 90 and close < ma200
exitShort = rsi2 < 30

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if exitLong
    strategy.close('Long')
if shortCondition
    strategy.entry('Short', strategy.short)
if exitShort
    strategy.close('Short')

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(ma200, '200 MA', color=color.gray)
bgcolor(longCondition ? color.new(color.green, 90) : shortCondition ? color.new(color.red, 90) : na)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'RSI2 Long', '{{ticker}} RSI2 extreme oversold in uptrend')
alertcondition(shortCondition, 'RSI2 Short', '{{ticker}} RSI2 extreme overbought in downtrend')
