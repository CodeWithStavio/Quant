//@version=5
strategy('Stochastic RSI', overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
rsiLen = input.int(14, 'RSI Length')
stochLen = input.int(14, 'Stoch Length')
kSmooth = input.int(3, 'K Smooth')
dSmooth = input.int(3, 'D Smooth')

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
rsi = ta.rsi(close, rsiLen)
stochK = ta.sma(ta.stoch(rsi, rsi, rsi, stochLen), kSmooth)
stochD = ta.sma(stochK, dSmooth)

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = ta.crossover(stochK, stochD) and stochK < 20
shortCondition = ta.crossunder(stochK, stochD) and stochK > 80

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(stochK, 'StochRSI K', color=color.blue)
plot(stochD, 'StochRSI D', color=color.orange)
hline(80, 'OB', color=color.red)
hline(20, 'OS', color=color.green)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'StochRSI Long', '{{ticker}} StochRSI oversold cross')
alertcondition(shortCondition, 'StochRSI Short', '{{ticker}} StochRSI overbought cross')
