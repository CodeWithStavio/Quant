//@version=5
strategy('Session Breakout', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// ASIAN SESSION RANGE
// For futures: 6PM - 3AM ET approximated with 4H bars
// ══════════════════════════════════════════
asianHigh = request.security(syminfo.tickerid, '240', ta.highest(high, 6))
asianLow = request.security(syminfo.tickerid, '240', ta.lowest(low, 6))

// ══════════════════════════════════════════
// TRADE DURING LONDON/NY OVERLAP
// 8AM - 12PM ET
// ══════════════════════════════════════════
londonNY = (hour >= 8 and hour < 12)

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = londonNY and ta.crossover(close, asianHigh)
shortCondition = londonNY and ta.crossunder(close, asianLow)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
bgcolor(londonNY ? color.new(color.blue, 95) : na)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'Session Long', '{{ticker}} broke Asian high in London/NY')
alertcondition(shortCondition, 'Session Short', '{{ticker}} broke Asian low in London/NY')
