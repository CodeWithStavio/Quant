//@version=5
strategy('Donchian Breakout', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
entryLen = input.int(20, 'Entry Length')
exitLen = input.int(10, 'Exit Length')

// ══════════════════════════════════════════
// ENTRY CHANNEL
// ══════════════════════════════════════════
entryUpper = ta.highest(high, entryLen)[1]
entryLower = ta.lowest(low, entryLen)[1]

// ══════════════════════════════════════════
// EXIT CHANNEL
// ══════════════════════════════════════════
exitUpper = ta.highest(high, exitLen)[1]
exitLower = ta.lowest(low, exitLen)[1]

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = high > entryUpper
shortCondition = low < entryLower

// Exit conditions
exitLong = low < exitLower
exitShort = high > exitUpper

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)
if exitLong
    strategy.close('Long')
if exitShort
    strategy.close('Short')

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(entryUpper, 'Entry Upper', color=color.green)
plot(entryLower, 'Entry Lower', color=color.red)
plot(exitUpper, 'Exit Upper', color=color.new(color.green, 50), style=plot.style_stepline)
plot(exitLower, 'Exit Lower', color=color.new(color.red, 50), style=plot.style_stepline)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'Donchian Long', '{{ticker}} broke 20-day high')
alertcondition(shortCondition, 'Donchian Short', '{{ticker}} broke 20-day low')
