//@version=5
strategy('RSI Divergence', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
rsiLen = input.int(14, 'RSI Length')
lookback = input.int(5, 'Pivot Lookback')

// ══════════════════════════════════════════
// RSI CALCULATION
// ══════════════════════════════════════════
rsi = ta.rsi(close, rsiLen)

// ══════════════════════════════════════════
// FIND PIVOTS
// ══════════════════════════════════════════
priceLL = ta.pivotlow(low, lookback, lookback)
priceHH = ta.pivothigh(high, lookback, lookback)
rsiLL = ta.pivotlow(rsi, lookback, lookback)
rsiHH = ta.pivothigh(rsi, lookback, lookback)

// ══════════════════════════════════════════
// DIVERGENCE DETECTION
// Bullish Divergence: Price Lower Low, RSI Higher Low
// Bearish Divergence: Price Higher High, RSI Lower High
// ══════════════════════════════════════════
bullishDiv = not na(priceLL) and low[lookback] < ta.valuewhen(not na(priceLL), low[lookback], 1) and rsi[lookback] > ta.valuewhen(not na(rsiLL), rsi[lookback], 1)
bearishDiv = not na(priceHH) and high[lookback] > ta.valuewhen(not na(priceHH), high[lookback], 1) and rsi[lookback] < ta.valuewhen(not na(rsiHH), rsi[lookback], 1)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if bullishDiv
    strategy.entry('Long', strategy.long)
if bearishDiv
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plotshape(bullishDiv, 'Bull Div', shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(bearishDiv, 'Bear Div', shape.triangledown, location.abovebar, color.red, size=size.small)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(bullishDiv, 'Bullish Divergence', '{{ticker}} RSI Bullish Divergence')
alertcondition(bearishDiv, 'Bearish Divergence', '{{ticker}} RSI Bearish Divergence')
