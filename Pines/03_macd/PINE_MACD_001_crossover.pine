//@version=5
strategy('MACD Crossover', overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
fastLen = input.int(12, 'Fast Length')
slowLen = input.int(26, 'Slow Length')
sigLen = input.int(9, 'Signal Length')

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
[macdLine, signalLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = ta.crossover(macdLine, signalLine)
shortCondition = ta.crossunder(macdLine, signalLine)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(macdLine, 'MACD', color=color.blue, linewidth=2)
plot(signalLine, 'Signal', color=color.orange, linewidth=2)
plot(histLine, 'Histogram', style=plot.style_histogram, color=histLine >= 0 ? color.green : color.red)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'MACD Long', '{{ticker}} MACD bullish crossover')
alertcondition(shortCondition, 'MACD Short', '{{ticker}} MACD bearish crossover')
