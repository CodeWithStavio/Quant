//@version=5
strategy('MACD Zero Cross', overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = ta.crossover(macdLine, 0)
shortCondition = ta.crossunder(macdLine, 0)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(macdLine, 'MACD', color=color.blue)
hline(0, 'Zero', color=color.gray)
plot(histLine, 'Hist', style=plot.style_histogram, color=histLine >= 0 ? color.green : color.red)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'MACD Zero Long', '{{ticker}} MACD crossed above zero')
alertcondition(shortCondition, 'MACD Zero Short', '{{ticker}} MACD crossed below zero')
