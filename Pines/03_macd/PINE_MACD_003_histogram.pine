//@version=5
strategy('MACD Histogram Reversal', overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// ══════════════════════════════════════════
// CONDITIONS
// Histogram turning from negative to positive (or vice versa)
// ══════════════════════════════════════════
longCondition = histLine > 0 and histLine[1] < 0
shortCondition = histLine < 0 and histLine[1] > 0

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(histLine, 'Histogram', style=plot.style_histogram, color=histLine >= 0 ? color.green : color.red, linewidth=3)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'Hist Long', '{{ticker}} MACD histogram turned positive')
alertcondition(shortCondition, 'Hist Short', '{{ticker}} MACD histogram turned negative')
