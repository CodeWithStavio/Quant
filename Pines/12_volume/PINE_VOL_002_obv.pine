//@version=5
strategy('OBV Strategy', overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
obv = ta.obv
obvMA = ta.sma(obv, 20)

// ══════════════════════════════════════════
// CONDITIONS
// OBV crossing its MA
// ══════════════════════════════════════════
longCondition = ta.crossover(obv, obvMA)
shortCondition = ta.crossunder(obv, obvMA)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(obv, 'OBV', color=color.blue, linewidth=2)
plot(obvMA, 'OBV MA', color=color.orange)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'OBV Long', '{{ticker}} OBV bullish')
alertcondition(shortCondition, 'OBV Short', '{{ticker}} OBV bearish')
