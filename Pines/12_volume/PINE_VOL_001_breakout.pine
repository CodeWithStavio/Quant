//@version=5
strategy('Volume Breakout', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
volLen = input.int(20, 'Volume MA Length')
volMult = input.float(2.0, 'Volume Multiplier')

// ══════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════
volMA = ta.sma(volume, volLen)
highVolume = volume > volMA * volMult

// ══════════════════════════════════════════
// CONDITIONS
// Breakout with volume
// ══════════════════════════════════════════
longCondition = close > ta.highest(high[1], 10) and highVolume and close > open
shortCondition = close < ta.lowest(low[1], 10) and highVolume and close < open

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
bgcolor(highVolume ? color.new(color.yellow, 90) : na)
plotshape(longCondition, 'Long', shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, 'Short', shape.triangledown, location.abovebar, color.red, size=size.small)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'Vol Long', '{{ticker}} bullish breakout with volume')
alertcondition(shortCondition, 'Vol Short', '{{ticker}} bearish breakout with volume')
