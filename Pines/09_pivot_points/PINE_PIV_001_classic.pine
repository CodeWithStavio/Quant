//@version=5
strategy('Pivot Points', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// DAILY PIVOT POINTS
// ══════════════════════════════════════════
pivot = request.security(syminfo.tickerid, 'D', (high[1] + low[1] + close[1]) / 3)
resist1 = pivot * 2 - request.security(syminfo.tickerid, 'D', low[1])
support1 = pivot * 2 - request.security(syminfo.tickerid, 'D', high[1])

// ══════════════════════════════════════════
// CONDITIONS
// Bounce off support/resistance
// ══════════════════════════════════════════
longCondition = low <= support1 and close > open
shortCondition = high >= resist1 and close < open

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(pivot, 'Pivot', color=color.yellow, linewidth=2)
plot(resist1, 'R1', color=color.red)
plot(support1, 'S1', color=color.green)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'Pivot Long', '{{ticker}} bounced off S1')
alertcondition(shortCondition, 'Pivot Short', '{{ticker}} rejected at R1')
