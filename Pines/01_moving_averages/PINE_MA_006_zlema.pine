//@version=5
strategy('ZLEMA Strategy', overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.62)

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
zlemaLen = input.int(20, 'ZLEMA Length')

// ══════════════════════════════════════════
// ZERO LAG EMA CALCULATION
// ══════════════════════════════════════════
lag = math.floor((zlemaLen - 1) / 2)
zlema = ta.ema(close + (close - close[lag]), zlemaLen)

// ══════════════════════════════════════════
// CONDITIONS
// ══════════════════════════════════════════
longCondition = ta.crossover(close, zlema)
shortCondition = ta.crossunder(close, zlema)

// ══════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════
if longCondition
    strategy.entry('Long', strategy.long)
if shortCondition
    strategy.entry('Short', strategy.short)

// ══════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════
plot(zlema, 'ZLEMA', color=close > zlema ? color.green : color.red, linewidth=2)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(longCondition, 'ZLEMA Long', '{{ticker}} above ZLEMA')
alertcondition(shortCondition, 'ZLEMA Short', '{{ticker}} below ZLEMA')
